# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored; this file is committed and must never hold
# a real token.
# ---------------------------------------------------------------------------

# Sanity project ID.
# Where: https://sanity.io/manage -> select the project -> the ID is shown on
# the project page and in the URL. Also readable via `npx sanity projects list`.
# Public: this is exposed to the browser and is not a secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=""

# Sanity dataset name.
# Where: https://sanity.io/manage -> project -> Datasets. Usually "production";
# this project uses "portfolio".
NEXT_PUBLIC_SANITY_DATASET=""

# Sanity API version — a date string that pins the API's behaviour so a future
# Sanity release cannot silently change query results.
# Where: pick today's date in YYYY-MM-DD when you first set it, then leave it
# alone. Optional; `sanity/env.ts` falls back to 2026-08-27 if unset.
NEXT_PUBLIC_SANITY_API_VERSION="2026-08-27"

# Sanity read token — used for draft/preview content and authenticated reads.
# Where: https://sanity.io/manage -> project -> API -> Tokens -> "Add API token".
# Give it the **Viewer** role (read-only) and copy the value immediately; it is
# shown once and cannot be retrieved again.
# SECRET: server-side only. No NEXT_PUBLIC_ prefix, never import it into a
# client component.
SANITY_API_READ_TOKEN=""

# The site's own origin, used for metadataBase, canonical URLs and OG images.
# Where: http://localhost:3000 for local development; the Vercel production
# domain once deployed. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
